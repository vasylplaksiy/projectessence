<div class='experience'>

    <div class='experience__content'>

        <div class='experience__top'>
            <div class='experience__intro'>
                A boutique salon brand designed around one truth: your self-care
                is not a luxury, it is a necessity.
            </div>
            <div class='experience__title'>Toronto, ON</div>
        </div>

        <div class='experience__center'>
            <div class='experience__tabs'>
                <div class='experience__tabs_header'>
                    <button
                        class='experience__tabs_el'
                        data-ind='1'
                        data-panel='pe-mission'
                    ><span>PE Mission</span></button>
                    <button
                        class='experience__tabs_el'
                        data-ind='2'
                        data-panel='pe-vision'
                    ><span>PE Vision</span></button>
                    <button
                        class='experience__tabs_el'
